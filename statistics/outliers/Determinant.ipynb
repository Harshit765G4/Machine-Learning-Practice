   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "6c71a944",
   "metadata": {},
   "outputs": [],
   "source": [
    "R = np.array([[0,-1],[1,0]])\n",
    "S = np.array([[2,0],[0,3]])\n",
    "C = np.array([[1,2],[2,4]])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "7f4f81a8",
   "metadata": {},
   "outputs": [],
   "source": [
    "det_R = np.linalg.det(R)\n",
    "det_S = np.linalg.det(S)\n",
    "det_C = np.linalg.det(C)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "fb969dae",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1.0 6.0 0.0\n"
     ]
    }
   ],
   "source": [
    "print(det_R, det_S, det_C)"
   ]
  },
