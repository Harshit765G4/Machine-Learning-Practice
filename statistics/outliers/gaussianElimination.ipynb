   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "21f45804",
   "metadata": {},
   "outputs": [],
   "source": [
    "A = np.array([\n",
    "    [300,100],\n",
    "    [100,200]\n",
    "])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "9dcaa444",
   "metadata": {},
   "outputs": [],
   "source": [
    "b = np.array([11000,8000])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "665479b0",
   "metadata": {},
   "outputs": [],
   "source": [
    "x = np.linalg.solve(A,b)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "546419d3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Units of Blend A(x): 28.0\n",
      "Units of Blend B(y): 26.0\n"
     ]
    }
   ],
   "source": [
    "print(f\"Units of Blend A(x): {x[0]}\")\n",
    "print(f\"Units of Blend B(y): {x[1]}\")"
   ]
  },
